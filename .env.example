# Server Configuration
PORT=3000
NODE_ENV=development
# CORS whitelist: để RỖNG = chặn mọi cross-origin (khuyến nghị, client là app
# mobile). '*' = mở cho mọi origin. Ví dụ whitelist: https://a.com,https://b.com
CORS_ORIGIN=

# Session TTL
SESSION_TTL_HOURS=720 # 30 days

# Firebase Admin Configuration
# Option 1: Path to service-account.json file
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Option 2: Raw JSON string or Base64 string of service account
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Set to true for local testing without real Firebase project credentials
FIREBASE_MOCK_MODE=true
